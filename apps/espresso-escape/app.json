{
  "expo": {
    "name": "Espresso Escape",
    "slug": "espresso-escape",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "espressoescape",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A120B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jrod042.espressoescape",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.jrod042.espressoescape",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#1A120B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4",
            "privacyManifestAggregationEnabled": false
          }
        }
      ]
    ],
    "extra": {
      "brand": "Casa Rustico",
      "eas": {
        "projectId": "016d7c24-a7df-4e0d-8e59-00a9d8db352c"
      }
    },
    "owner": "jrod42"
  }
}
