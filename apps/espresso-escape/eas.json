{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium",
        "image": "latest",
        "simulator": false
      },
      "android": {
        "image": "latest",
        "buildType": "apk"
      },
      "env": {
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true",
        "EXPO_USE_PRECOMPILED_MODULES": "0"
      }
    },
    "internal": {
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium",
        "image": "latest",
        "simulator": false
      },
      "android": {
        "image": "latest",
        "buildType": "apk"
      },
      "env": {
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true",
        "EXPO_USE_PRECOMPILED_MODULES": "0"
      }
    },
    "preview": {
      "extends": "internal"
    },
    "production": {
      "distribution": "store",
      "ios": {
        "resourceClass": "m-medium",
        "image": "latest",
        "simulator": false
      },
      "android": {
        "image": "latest"
      },
      "env": {
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true",
        "EXPO_USE_PRECOMPILED_MODULES": "0"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "FY5H9V76QL",
        "ascAppId": "6758108565",
        "bundleIdentifier": "com.jrod042.espressoescape"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
