{
  "expo": {
    "name": "Casa Rustico Go",
    "slug": "casa-rustico-go",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "casarusticogo",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#14100C"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jrod042.casarusticogo",
      "buildNumber": "3",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "Casa Rustico Go"
      }
    },
    "android": {
      "package": "com.jrod042.casarusticogo",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#14100C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4",
            "privacyManifestAggregationEnabled": false
          }
        }
      ],
      "expo-font"
    ],
    "extra": {
      "brand": "Casa Rustico",
      "eas": {
        "projectId": "25937717-3f2f-4793-af4d-79a12310f02a"
      }
    },
    "owner": "jrod42"
  }
}
